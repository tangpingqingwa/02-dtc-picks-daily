# Copy to .env.local. Never commit secrets.
# Runtime selection is explicit. Fixture is local/test-only and stays on loopback.
NODE_ENV=development
HOST=127.0.0.1
PAYMENT_MODE=fixture
# Use exactly one in a live deployment: waffo-test or waffo-prod.
# PAYMENT_MODE=waffo-test
# PAYMENT_MODE=waffo-prod

# Waffo Pancake (official @waffo/pancake-ts@0.19.1) live configuration.
# WAFFO_LIVE is a quarantined legacy flag; it is ignored. Set PAYMENT_MODE.
WAFFO_LIVE=
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
# Legacy compatibility name; active test/prod verification ignores this key.
WAFFO_WEBHOOK_PUBLIC_KEY=
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/board.sqlite

# POLAR variables below are retained as inert compatibility research only;
# the runtime never selects Polar and they do not override PAYMENT_MODE.
POLAR_API_BASE=
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
POLAR_FIXTURE_ONLY=
POLAR_LIVE=
